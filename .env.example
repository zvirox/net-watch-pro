# Net Watch Pro — environment variables (ARCHITECTURE.md §8.3; closed list).
#
# ⚠ Phase 0 note: the daemon does not read these yet (netwatchd is a skeleton
# until P1.1). This file exists so dev setups are ready when it does.
# NEVER commit a real .env (gitignored; this example file is the template).
# There are no secrets here: authorization is via the root-owned allowed-UID
# list (one pkexec prompt at onboarding); no per-boot token (ARCHITECTURE.md §8.3).

# DB + state directory (systemd sets it in production)
NETWATCH_DATA_DIR=/var/lib/netwatch-pro
# Log output directory (default: $NETWATCH_DATA_DIR/log)
NETWATCH_LOG_DIR=/var/lib/netwatch-pro/log
# error | warn | info | debug | trace
NETWATCH_LOG_LEVEL=info
# Unix domain socket path; peer-credential UID allowlist authorization
NETWATCH_API_SOCKET=/run/netwatch-pro/api.sock
# Group id allowed to connect (socket 0660); defaults to sudo's caller group
# NETWATCH_API_GID=1000
# Default retention; a Pro setting may raise it (default 90)
NETWATCH_RETENTION_DAYS=90
# Diagnostic: set to any value to run with an empty collector (degraded chip)
# NETWATCH_DISABLE_EBPF=1
# Dev only: point the UI at a dev daemon socket; never read in packaged builds
# NETWATCH_DEV_DAEMON_ADDR=/run/netwatch-pro/dev.sock
