<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD polkit Policy Configuration 1.0//EN" "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>
  <vendor>Net Watch Pro</vendor>
  <vendor_url>https://github.com/zvirox/net-watch-pro</vendor_url>
  <action id="pro.netwatch.token-helper.read-token">
    <description>Read the Net Watch Pro daemon token</description>
    <message>Authentication is required to connect Net Watch Pro to its system daemon</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/netwatch-token-helper</annotate>
  </action>
</policyconfig>
