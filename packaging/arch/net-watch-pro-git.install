# AUR install hooks for net-watch-pro-git (P8.4).
# Root-side setup mirrors the .deb/.rpm scripts: socket group, state dir and
# GID drop-in. The unit is deliberately NOT enabled — onboarding (P8.5) does
# that after health checks and the single admin prompt.

post_install() {
  getent group netwatch >/dev/null 2>&1 || groupadd --system netwatch
  local gid
  gid="$(getent group netwatch | cut -d: -f3)"
  install -d -m 0755 /etc/netwatch-pro
  install -d -m 0750 -o root -g netwatch /var/lib/netwatch-pro
  install -d -m 0755 /etc/systemd/system/netwatchd.service.d
  printf '[Service]\nEnvironment=NETWATCH_API_GID=%s\n' "$gid" \
    > /etc/systemd/system/netwatchd.service.d/10-socket-group.conf
  systemctl daemon-reload 2>/dev/null || true
  update-desktop-database -q /usr/share/applications 2>/dev/null || true
}

post_upgrade() {
  systemctl daemon-reload 2>/dev/null || true
  update-desktop-database -q /usr/share/applications 2>/dev/null || true
}

post_remove() {
  systemctl stop netwatchd.service 2>/dev/null || true
  systemctl disable netwatchd.service 2>/dev/null || true
  rm -f /etc/systemd/system/netwatchd.service.d/10-socket-group.conf
  rmdir /etc/systemd/system/netwatchd.service.d 2>/dev/null || true
  systemctl daemon-reload 2>/dev/null || true
  update-desktop-database -q /usr/share/applications 2>/dev/null || true

  # Delete data by default; keeping it is opt-in via the marker file.
  keep=0
  if [ -f /etc/netwatch-pro/keep-data ]; then
    keep=1
  fi
  if [ "$keep" -eq 0 ]; then
    rm -rf /var/lib/netwatch-pro
  fi
  rm -f /etc/netwatch-pro/allowed-uids /etc/netwatch-pro/keep-data
  rmdir /etc/netwatch-pro 2>/dev/null || true
}
