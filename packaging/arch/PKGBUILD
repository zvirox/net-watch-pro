# Maintainer: Net Watch Pro maintainers <maintainers@netwatchpro.invalid>
# AUR dev channel: net-watch-pro-git (PLAN P8.4). Stable -/-bin packages land at GA.
pkgname=net-watch-pro-git
_pkgname=net-watch-pro
pkgver=0.9.0.beta.1.r0.gbc9f33b
pkgrel=3
pkgdesc='Local network-traffic monitor and per-app usage tracker (dev channel)'
arch=('x86_64')
url='https://github.com/zvirox/net-watch-pro'
license=('AGPL-3.0-or-later')
depends=('systemd' 'webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'librsvg')
makedepends=('git' 'rust' 'cargo' 'rust-src' 'nodejs' 'npm' 'pkgconf'
             'webkit2gtk-4.1' 'gtk3' 'gtk4' 'libayatana-appindicator' 'librsvg')
provides=('net-watch-pro')
conflicts=('net-watch-pro' 'net-watch-pro-bin')
install=net-watch-pro-git.install
source=("net-watch-pro::git+https://github.com/zvirox/net-watch-pro.git#branch=main"
        'net-watch-pro-git.install')
sha256sums=('SKIP' '5b8ea9346150a0a64537f0bf36072055d7b7f42df740cfa9d1f6dde62449d271')

pkgver() {
  cd "$srcdir/$_pkgname" || { printf '%s' "$pkgver"; return; }
  git describe --long --tags --always 2>/dev/null \
    | sed 's/^v//; s/\([^-]*-g\)/r\1/; s/-/./g' \
    || printf '%s' "$pkgver"
}

build() {
  cd "$srcdir/$_pkgname"
  # makepkg's CFLAGS/LDFLAGS (-fno-plt, --as-needed, ...) break the bundled
  # SQLite C code compiled for sqlx's proc-macros: cargo then fails with
  # "undefined symbol: sqlite3_free". Use the Rust toolchain defaults instead.
  export CFLAGS=""
  export CXXFLAGS=""
  export LDFLAGS=""
  # eBPF object: pinned bpf-linker (the version verified by the spike) is
  # installed into $srcdir so the recipe does not depend on the distro's
  # bpf-linker version. Stable Rust + RUSTC_BOOTSTRAP=1 + rust-src is enough
  # (no nightly toolchain needed). The object is embedded by build.rs.
  export PATH="$srcdir/bpf-tools/bin:$PATH"
  cargo install --locked bpf-linker --version 0.13.0 --root "$srcdir/bpf-tools"
  cargo run -p xtask -- bpf

  # Tauri release builds embed frontendDist (app/dist), so build the UI first.
  (cd app && npm ci && npm run build)
  # Plain cargo builds leave Tauri in dev mode (loads devUrl http://127.0.0.1:5173).
  # custom-protocol makes the release binary serve the embedded frontendDist.
  cargo build --release -p netwatchd
  cargo build --release -p netwatch-app --features tauri/custom-protocol
}

package() {
  cd "$srcdir/$_pkgname"
  install -Dm755 target/release/netwatchd "$pkgdir/usr/bin/netwatchd"
  install -Dm755 target/release/netwatch-app "$pkgdir/usr/bin/netwatch-app"
  install -Dm644 packaging/systemd/netwatchd.service \
    "$pkgdir/usr/lib/systemd/system/netwatchd.service"
  install -Dm644 packaging/deb/net-watch-pro.desktop \
    "$pkgdir/usr/share/applications/net-watch-pro.desktop"
  install -Dm644 app/src-tauri/icons/icon@2x.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/net-watch-pro.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
