#!/bin/sh
# P8.7: remove ALL service residue; delete recorded data by default. Keeping
# data is opt-in via /etc/netwatch-pro/keep-data before uninstall (PRD §6.1 #10).
set -e

case "${1:-}" in
  remove|purge|disappear)
    systemctl stop netwatchd.service 2>/dev/null || true
    systemctl disable netwatchd.service 2>/dev/null || true
    rm -f /etc/systemd/system/netwatchd.service.d/10-socket-group.conf
    rmdir /etc/systemd/system/netwatchd.service.d 2>/dev/null || true
    systemctl daemon-reload 2>/dev/null || true

    if command -v update-desktop-database >/dev/null 2>&1; then
      update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
    fi

    keep=0
    if [ "$1" != "purge" ] && [ -f /etc/netwatch-pro/keep-data ]; then
      keep=1
    fi
    if [ "$keep" -eq 0 ]; then
      rm -rf /var/lib/netwatch-pro
    fi
    rm -f /etc/netwatch-pro/allowed-uids /etc/netwatch-pro/keep-data
    rmdir /etc/netwatch-pro 2>/dev/null || true
    ;;
esac

exit 0
