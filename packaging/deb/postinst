#!/bin/sh
# P8.2: register the hardened unit, but leave it DISABLED until onboarding.
set -e

case "${1:-}" in
  configure)
    # Group that may connect to the root daemon's 0660 API socket
    # (ARCHITECTURE.md §8.3 NETWATCH_API_GID).
    if ! getent group netwatch >/dev/null 2>&1; then
      groupadd --system netwatch
    fi
    GID="$(getent group netwatch | cut -d: -f3)"

    install -d -m 0755 /etc/netwatch-pro
    install -d -m 0750 -o root -g netwatch /var/lib/netwatch-pro

    # Drop-in rather than editing the shipped unit: the group is a host detail.
    install -d -m 0755 /etc/systemd/system/netwatchd.service.d
    cat > /etc/systemd/system/netwatchd.service.d/10-socket-group.conf <<EOF
[Service]
Environment=NETWATCH_API_GID=${GID}
EOF

    systemctl daemon-reload 2>/dev/null || true
    # An upgrade replaces /usr/bin/netwatchd; restart only a unit that was
    # already active so the new binary serves the API (P8.12). A fresh install
    # has no $2 and stays disabled until onboarding.
    if [ -n "${2:-}" ] && systemctl is-active --quiet netwatchd.service 2>/dev/null; then
      systemctl restart netwatchd.service >/dev/null 2>&1 || true
    fi
    # Deliberately no `systemctl enable` — P8.5 onboarding does that after
    # health checks and the single admin prompt (PRD Flow 4, D1a).

    if command -v update-desktop-database >/dev/null 2>&1; then
      update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
    fi
    ;;
esac

exit 0
