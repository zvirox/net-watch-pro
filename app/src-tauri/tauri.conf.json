{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Net Watch Pro",
  "version": "0.0.1",
  "identifier": "pro.netwatch.app",
  "build": {
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Net Watch Pro",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/128x128.png", "icons/icon@2x.png"]
  }
}
